@model IEnumerable<EmployeeManagementSystem.Models.Employee>

<h1>Employees</h1>

<a asp-action="Create">Add Employee</a>

<table border="1">

    <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Designation</th>
        <th>Email</th>
        <th>Salary</th>
        <th>Department</th>
        <th>Actions</th>
    </tr>

    @foreach (var employee in Model)
    {
        <tr>
            <td>@employee.EmployeeId</td>
            <td>@employee.EmployeeName</td>
            <td>@employee.Designation</td>
            <td>@employee.Email</td>
            <td>@employee.Salary</td>
            <td>@employee.Department</td>

            <td>
                <a asp-action="Edit"
                   asp-route-id="@employee.EmployeeId">
                    Edit
                </a>

                <a asp-action="Details"
                   asp-route-id="@employee.EmployeeId">
                    Details
                </a>

                <a asp-action="Delete"
                   asp-route-id="@employee.EmployeeId">
                    Delete
                </a>
            </td>
        </tr>
    }

</table>